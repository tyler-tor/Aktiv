# Copy to react-app/.env.local (git-ignored) and fill in. Vite only exposes
# variables that start with VITE_, and reads them at `npm run dev` /
# `npm run build` time (restart the dev server after changing them).

# Google Maps browser key (Maps JavaScript API + Static Maps API), restricted
# by HTTP referrer to your site and http://localhost:3000/*. See CHANGES.md (A12).
# (Was REACT_APP_GOOGLE_MAPS_API_KEY before the move to Vite in A19.)
VITE_GOOGLE_MAPS_API_KEY=
