# Copy to react-app/.env.local (git-ignored) and fill in. CRA only exposes
# variables that start with REACT_APP_, and reads them at `npm start` /
# `npm run build` time (restart the dev server after changing them).

# Google Maps browser key (Maps JavaScript API + Static Maps API), restricted
# by HTTP referrer to your site and http://localhost:3000/*. See CHANGES.md (A12).
REACT_APP_GOOGLE_MAPS_API_KEY=

# Not used by the code (the dev server proxies /api to Flask via "proxy" in package.json).
REACT_APP_BASE_URL=http://localhost:5000
