# No need for DATABASE_URL to be set if developing from within a devcontainer

# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///dev.db
SCHEMA=flask_schema
# development | testing | production (replaces FLASK_ENV)
APP_ENV=development
# Set to 0 to stop printing every SQL query in development
# SQLALCHEMY_ECHO=0
# S3 uploads. Credentials are NOT set here: boto3 uses the EC2 IAM role in
# production and your ~/.aws profile (aws configure / aws sso login) locally.
S3_BUCKET=awsbucketname
AWS_REGION=us-west-2
# Optional: public base URL for uploads (e.g. a CloudFront domain)
# S3_PUBLIC_URL=https://cdn.example.com/
REACT_APP_NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=googlemapsapikey
